# Blumira MCP Server Configuration
# Copy this file to .env and fill in the required values

# Required: JWT access token for the Blumira Public API
BLUMIRA_ACCESS_TOKEN=your_blumira_jwt_token_here

# Optional: Base URL (defaults to production API)
# BLUMIRA_BASE_URL=https://api.blumira.com/public-api/v1

# Optional: Log level (debug, info, warn, error — default: info)
# BLUMIRA_LOG_LEVEL=info
